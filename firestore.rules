rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isActiveMember() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.active == true
        && get(profilePath(request.auth.uid)).data.familyId == 'family-prime'
        && get(profilePath(request.auth.uid)).data.mustChangePassword == false;
    }

    function isAdmin() {
      return isActiveMember()
        && get(profilePath(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /lists/shopping {
      allow read: if isActiveMember();
      allow create: if false;
      allow update: if isActiveMember()
        && request.resource.data.items == resource.data.items
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stores', 'currentStore', 'promptHistory', 'loyaltyCards']);
      allow delete: if false;
    }

    match /familyEvents/{eventId} {
      allow read: if isActiveMember() && resource.data.familyId == 'family-prime';
      allow create: if isActiveMember()
        && request.resource.data.familyId == 'family-prime'
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'familyId', 'title', 'startDate', 'time', 'recurrence',
          'recurrenceUntil', 'memberIds', 'creatorUid', 'creatorName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'familyId', 'title', 'startDate', 'time', 'recurrence',
          'recurrenceUntil', 'memberIds', 'creatorUid', 'creatorName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.recurrence in ['none', 'daily', 'weekly', 'monthly', 'yearly']
        && request.resource.data.recurrenceUntil is string
        && (request.resource.data.recurrenceUntil == ''
          || request.resource.data.recurrenceUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (request.resource.data.recurrence != 'none' || request.resource.data.recurrenceUntil == '')
        && (request.resource.data.recurrenceUntil == ''
          || request.resource.data.recurrenceUntil >= request.resource.data.startDate)
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 100
        && request.resource.data.creatorName is string
        && request.resource.data.creatorName.size() <= 80
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isActiveMember()
        && resource.data.familyId == 'family-prime'
        && resource.data.creatorUid == request.auth.uid
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasAll([
          'familyId', 'title', 'startDate', 'time', 'recurrence',
          'recurrenceUntil', 'memberIds', 'creatorUid', 'creatorName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'familyId', 'title', 'startDate', 'time', 'recurrence',
          'recurrenceUntil', 'memberIds', 'creatorUid', 'creatorName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.recurrence in ['none', 'daily', 'weekly', 'monthly', 'yearly']
        && request.resource.data.recurrenceUntil is string
        && (request.resource.data.recurrenceUntil == ''
          || request.resource.data.recurrenceUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (request.resource.data.recurrence != 'none' || request.resource.data.recurrenceUntil == '')
        && (request.resource.data.recurrenceUntil == ''
          || request.resource.data.recurrenceUntil >= request.resource.data.startDate)
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 100
        && request.resource.data.creatorName is string
        && request.resource.data.creatorName.size() <= 80
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isActiveMember()
        && resource.data.familyId == 'family-prime'
        && resource.data.creatorUid == request.auth.uid;
    }

    match /iceboxItems/{itemId} {
      allow read: if isActiveMember() && resource.data.familyId == 'family-prime';
      allow create: if isActiveMember()
        && request.resource.data.familyId == 'family-prime'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'familyId', 'name', 'flavor', 'quantity', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'familyId', 'name', 'flavor', 'quantity', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.flavor is string
        && request.resource.data.flavor.size() <= 100
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 9999
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isActiveMember()
        && resource.data.familyId == 'family-prime'
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasAll([
          'familyId', 'name', 'flavor', 'quantity', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'familyId', 'name', 'flavor', 'quantity', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.flavor is string
        && request.resource.data.flavor.size() <= 100
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= 9999
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isActiveMember() && resource.data.familyId == 'family-prime';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
