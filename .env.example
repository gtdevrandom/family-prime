GOOGLE_API_KEY=your_api_key_here
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_web_app_id
# Exact browser origins allowed to call this backend (comma-separated).
FAMILY_PRIME_ALLOWED_ORIGINS=http://localhost:3000
# Optional:
FIREBASE_MEASUREMENT_ID=
# Server-only JSON from a dedicated Firebase service account. Never expose to the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=
