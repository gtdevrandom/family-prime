{
  "name": "family-prime",
  "version": "2.1.0",
  "description": "Application famille avec support offline - gère tâches, calendrier et listes de courses",
  "type": "module",
  "keywords": [
    "firebase",
    "firestore",
    "offline",
    "pwa",
    "family",
    "shopping-list"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.16.0",
    "firebase-admin": "^13.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test",
    "firebase:bootstrap": "node scripts/bootstrap-admin.js",
    "firebase:migrate": "node scripts/migrate-firestore.js"
  },
  "features": {
    "offlineFirstArchitecture": true,
    "firebaseIntegration": true,
    "realtimeSync": true,
    "indexedDBCache": true,
    "autoSynchronization": false,
    "connectionIndicator": true,
    "testing": true
  }
}
